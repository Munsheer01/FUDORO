rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Menu Data: Everyone can read, admins can write
    match /Enhanced_Authentic_Platters/{docId} {
      allow read: if true;
      allow write: if true; // Temporarily allow all writes for testing
    }

    // ✅ NEW: MealBoxes Collection - Public read, admin write
    match /MealBoxes/{mealBoxId} {
      allow read: if true; // Anyone can browse meal boxes
      allow write: if true; // Temporarily allow all writes for testing
      // For production: allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // Orders: Anyone can create (including guests), read own orders
    match /orders/{orderId} {
      allow create: if true; // ✅ This fixes your order placement issue
      allow read: if true; // Temporarily allow all reads for testing
      allow update, delete: if false; // Prevent order modifications
    }

    // Inventory: Admin operations (allow all for testing)
    match /inventory/{docId} {
      allow read, write: if true; // Temporarily allow all for admin testing
    }

    // Inventory Logs: Admin operations (allow all for testing)
    match /inventory_logs/{docId} {
      allow read, write: if true; // Temporarily allow all for admin testing
    }

    // User profiles (if implemented later)
    match /users/{userId} {
      allow read, write: if true;
    }
  }
}
