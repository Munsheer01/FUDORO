# FUDORO Notification Service Configuration
# Add these to your .env.development or .env.production file

# ============================================
# NOTIFICATION SETTINGS
# ============================================

# Enable/Disable notifications (set to false during development if not configured)
REACT_APP_NOTIFICATIONS_ENABLED=true

# ============================================
# TWILIO CONFIGURATION (Recommended)
# ============================================
# Get credentials from: https://console.twilio.com/
# Supports both WhatsApp and SMS

REACT_APP_TWILIO_ACCOUNT_SID=your_account_sid_here
REACT_APP_TWILIO_AUTH_TOKEN=your_auth_token_here
REACT_APP_TWILIO_PHONE_NUMBER=+1234567890
REACT_APP_TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ============================================
# MSG91 CONFIGURATION (Popular in India)
# ============================================
# Get credentials from: https://msg91.com/
# Supports WhatsApp and SMS with Indian numbers

REACT_APP_MSG91_AUTH_KEY=your_msg91_auth_key_here
REACT_APP_MSG91_SENDER_ID=FUDORO
REACT_APP_MSG91_FLOW_ID=your_flow_id_here
REACT_APP_MSG91_WHATSAPP_NUMBER=919876543210
REACT_APP_MSG91_WHATSAPP_TEMPLATE_ID=your_template_id_here

# ============================================
# BUSINESS CONTACT NUMBERS
# ============================================
# Numbers that will receive order notifications

REACT_APP_BUSINESS_PHONE_PRIMARY=+918919354409
REACT_APP_BUSINESS_PHONE_SECONDARY=+919703344431

# ============================================
# NOTIFICATION PREFERENCES
# ============================================

# Choose provider: 'twilio', 'msg91', or 'none' (for development logging only)
REACT_APP_NOTIFICATION_PROVIDER=none

# Enable specific channels
REACT_APP_WHATSAPP_ENABLED=true
REACT_APP_SMS_ENABLED=true
